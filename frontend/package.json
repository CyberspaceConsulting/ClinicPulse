{
  "name": "medora-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:i18n": "node --test ../tests/i18n.test.mjs",
    "test:e2e": "playwright test --config ../tests/frontend/playwright.config.mjs",
    "test:e2e:chromium": "playwright test --config ../tests/frontend/playwright.config.mjs --project=desktop --project=mobile",
    "test:e2e:firefox": "playwright test --config ../tests/frontend/playwright.config.mjs --project=firefox --project=firefox-mobile"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14"
  }
}
